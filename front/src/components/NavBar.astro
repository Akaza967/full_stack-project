---
import { Home, Shield, Users as UsersIcon, Trophy, Settings, LogIn, Moon, Sun } from "@lucide/astro";
---

<header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
    <a href="/" class="flex items-center gap-2 text-sm font-semibold text-slate-900">
      <Home size={18} />
      Campeonato
    </a>

    <ul class="flex items-center gap-1 text-sm">
      <li>
        <a
          href="/torneos"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900"
        >
          <Trophy size={16} />
          Torneos
        </a>
      </li>
      <li>
        <a
          href="/equipos"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900"
        >
          <Shield size={16} />
          Equipos
        </a>
      </li>
      <li>
        <a
          href="/jugadores"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900"
        >
          <UsersIcon size={16} />
          Jugadores
        </a>
      </li>
      <li id="nav-admin" hidden>
        <a
          href="/admin"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-indigo-700 hover:bg-indigo-50"
        >
          <Settings size={16} />
          Admin
        </a>
      </li>
      <li id="nav-me" hidden>
        <a
          href="/me"
          class="inline-flex items-center rounded-lg px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900"
        >
          Mi perfil
        </a>
      </li>
      <li>
        <button
          id="theme-toggle"
          type="button"
          class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm text-slate-600 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 hover:dark:bg-slate-800"
          aria-label="Cambiar tema"
        >
          <Moon id="theme-icon-moon" size={16} class="hidden" />
          <Sun id="theme-icon-sun" size={16} class="hidden" />
          <span id="theme-label">Tema</span>
        </button>
      </li>
      <li id="nav-login">
        <a
          href="/login"
          class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-1.5 text-white hover:bg-slate-800"
        >
          <LogIn size={14} />
          Iniciar sesión
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { auth } from "@/lib/api";

  const user = auth.getUser();
  const themeButton = document.getElementById("theme-toggle");
  const themeLabel = document.getElementById("theme-label");
  const moonIcon = document.getElementById("theme-icon-moon");
  const sunIcon = document.getElementById("theme-icon-sun");

  function setTheme(isDark: boolean) {
    document.documentElement.classList.toggle("dark", isDark);
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch (err) {
      console.warn("Could not save theme preference", err);
    }

    if (themeLabel) {
      themeLabel.textContent = isDark ? "Tema oscuro" : "Tema claro";
    }
    if (moonIcon) moonIcon.classList.toggle("hidden", !isDark);
    if (sunIcon) sunIcon.classList.toggle("hidden", isDark);
  }

  function initTheme() {
    try {
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = stored === "dark" || (!stored && prefersDark);
      setTheme(isDark);
    } catch (err) {
      console.warn("Theme initialization error", err);
      setTheme(false);
    }
  }

  if (themeButton) {
    themeButton.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      setTheme(!isDark);
    });
  }

  initTheme();

  if (user) {
    document.getElementById("nav-login")!.hidden = true;
    document.getElementById("nav-me")!.hidden = false;
    if (user.role === "ADMIN") {
      document.getElementById("nav-admin")!.hidden = false;
    }
  }
</script>

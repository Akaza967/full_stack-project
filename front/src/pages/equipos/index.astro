---
import Layout from "@/layouts/Layout.astro";
import { Shield } from "@lucide/astro";
---

<Layout title="Equipos">
  <main class="mx-auto max-w-5xl px-6 py-10">
    <header class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-indigo-600">Catálogo</p>
        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
          Equipos
        </h1>
      </div>
    </header>

    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950">
      <label class="block">
        <span class="text-sm font-medium text-slate-700 dark:text-slate-200">Buscar equipos</span>
        <input
          id="filter-search"
          type="search"
          placeholder="Nombre del equipo o ciudad"
          class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:ring-indigo-500/20"
        />
      </label>
    </section>

    <section
      id="loading"
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400"
    >
      Cargando equipos…
    </section>

    <section
      id="empty"
      hidden
      class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center"
    >
      <Shield size={28} class="mx-auto text-slate-400" />
      <p class="mt-3 text-sm text-slate-500">
        Todavía no hay equipos registrados.
      </p>
    </section>

    <ul
      id="grid"
      hidden
      class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
    >
    </ul>
  </main>
</Layout>

<script>
  import { api, ApiError, cloudinaryUrl, type Team } from "@/lib/api";

  const loading = document.getElementById("loading") as HTMLElement;
  const empty = document.getElementById("empty") as HTMLElement;
  const grid = document.getElementById("grid") as HTMLUListElement;
  const searchInput = document.getElementById("filter-search") as HTMLInputElement | null;
  
  let allTeams: Team[] = [];

  function initials(name: string): string {
    return name
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((p) => p[0]!.toUpperCase())
      .join("");
  }

  function renderCard(team: Team): HTMLLIElement {
    const li = document.createElement("li");
    li.className =
      "flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900";

    const link = document.createElement("a");
    link.href = `/equipos/ver?id=${encodeURIComponent(team.id)}`;
    link.className = "flex items-center gap-4";

    const logoBox = document.createElement("div");
    logoBox.className =
      "flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-slate-100 text-base font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400";

    const logo = cloudinaryUrl(team.logoUrl, "w_120,h_120,c_fill,q_auto,f_auto");
    if (logo) {
      const img = document.createElement("img");
      img.src = logo;
      img.alt = team.name;
      img.width = 56;
      img.height = 56;
      img.loading = "lazy";
      img.className = "h-full w-full object-cover";
      logoBox.appendChild(img);
    } else {
      logoBox.textContent = initials(team.name);
    }

    const meta = document.createElement("div");
    meta.className = "min-w-0";

    const name = document.createElement("p");
    name.className = "truncate text-base font-semibold text-slate-900 dark:text-slate-100";
    name.textContent = team.name;

    const sub = document.createElement("p");
    sub.className = "truncate text-xs text-slate-500 dark:text-slate-400";
    const parts = [team.city, team.foundedYear ? `Fundado ${team.foundedYear}` : null].filter(
      Boolean,
    );
    sub.textContent = parts.length ? (parts.join(" · ") as string) : "—";

    meta.append(name, sub);
    link.append(logoBox, meta);
    li.appendChild(link);
    return li;
  }

  function renderGrid(items: Team[]) {
    grid.replaceChildren(...items.map(renderCard));
    grid.hidden = items.length === 0;
    empty.hidden = items.length !== 0;
  }

  function applyFilters() {
    const query = (searchInput?.value ?? "").toLowerCase();
    const filtered = allTeams.filter((t) => {
      if (query) {
        const label = `${t.name} ${t.shortName ?? ""} ${t.city ?? ""}`.toLowerCase();
        if (!label.includes(query)) {
          return false;
        }
      }
      return true;
    });
    renderGrid(filtered);
  }

  if (searchInput) {
    searchInput.addEventListener("input", applyFilters);
  }

  try {
    allTeams = await api.listTeams();
    loading.hidden = true;

    if (allTeams.length === 0) {
      empty.hidden = false;
    } else {
      renderGrid(allTeams);
    }
  } catch (err) {
    loading.textContent =
      err instanceof ApiError ? err.messages.join(" · ") : "Error al cargar";
  }
</script>

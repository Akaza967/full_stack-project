---
import Layout from "@/layouts/Layout.astro";
import { MapPin, CalendarDays, Palette } from "@lucide/astro";
---

<Layout title="Equipo">
  <main class="mx-auto max-w-3xl px-6 py-10">
    <div class="flex items-center justify-between">
      <a
        href="/equipos"
        class="text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300"
      >← Volver a equipos</a>

      <button
        id="fav-btn"
        hidden
        class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 hover:text-pink-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-pink-400"
      >
        <svg id="fav-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        <span id="fav-text">Guardar</span>
      </button>
    </div>

    <section
      id="loading"
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500"
    >
      Cargando…
    </section>

    <section
      id="content"
      hidden
      class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >
      <div class="flex items-center gap-5 border-b border-slate-100 p-6">
        <div
          id="logo"
          class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-slate-100 text-xl font-semibold text-slate-500"
        >
        </div>
        <div class="min-w-0">
          <h1 id="name" class="truncate text-2xl font-semibold text-slate-900"></h1>
          <p id="short" class="text-sm text-slate-500"></p>
        </div>
      </div>

      <dl class="divide-y divide-slate-100 text-sm">
        <div class="flex items-center justify-between px-6 py-4">
          <dt class="flex items-center gap-2 text-slate-500">
            <MapPin size={16} />
            Ciudad
          </dt>
          <dd id="city" class="font-medium text-slate-900"></dd>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <dt class="flex items-center gap-2 text-slate-500">
            <CalendarDays size={16} />
            Fundación
          </dt>
          <dd id="founded" class="font-medium text-slate-900"></dd>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <dt class="flex items-center gap-2 text-slate-500">
            <Palette size={16} />
            Color principal
          </dt>
          <dd id="color" class="flex items-center gap-2 font-medium text-slate-900"></dd>
        </div>
      </dl>
    </section>
  </main>
</Layout>

<script>
  import { api, ApiError, cloudinaryUrl, auth } from "@/lib/api";

  const params = new URLSearchParams(window.location.search);
  const id = params.get("id");

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;
  const favBtn = document.getElementById("fav-btn") as HTMLButtonElement;
  const favIcon = document.getElementById("fav-icon") as HTMLElement;
  const favText = document.getElementById("fav-text") as HTMLElement;

  let favoriteId: string | null = null;
  let isSubmitting = false;
  const token = auth.getToken();

  function updateFavUI() {
    if (favoriteId) {
      favIcon.setAttribute("fill", "currentColor");
      favIcon.classList.add("text-pink-600", "dark:text-pink-500");
      favText.textContent = "Guardado";
    } else {
      favIcon.setAttribute("fill", "none");
      favIcon.classList.remove("text-pink-600", "dark:text-pink-500");
      favText.textContent = "Guardar";
    }
  }

  function setText(id: string, value: string) {
    document.getElementById(id)!.textContent = value;
  }

  if (!id) {
    loading.textContent = "Falta el id del equipo";
  } else {
    try {
      const team = await api.getTeam(id);

      setText("name", team.name);
      setText("short", team.shortName ?? "");
      setText("city", team.city ?? "—");
      setText("founded", team.foundedYear ? String(team.foundedYear) : "—");

      const logoBox = document.getElementById("logo")!;
      const logo = cloudinaryUrl(team.logoUrl, "w_160,h_160,c_fill,q_auto,f_auto");
      if (logo) {
        const img = document.createElement("img");
        img.src = logo;
        img.alt = team.name;
        img.className = "h-full w-full object-cover";
        logoBox.replaceChildren(img);
      } else {
        logoBox.textContent = team.name
          .split(/\s+/)
          .slice(0, 2)
          .map((p) => p[0]?.toUpperCase() ?? "")
          .join("");
      }

      const colorBox = document.getElementById("color")!;
      if (team.primaryColor) {
        const swatch = document.createElement("span");
        swatch.className = "h-4 w-4 rounded-full border border-slate-200";
        swatch.style.backgroundColor = team.primaryColor;
        const text = document.createElement("span");
        text.textContent = team.primaryColor;
        colorBox.replaceChildren(swatch, text);
      } else {
        colorBox.textContent = "—";
      }

      loading.hidden = true;
      content.hidden = false;

      if (token) {
        favBtn.hidden = false;
        try {
          const favorites = await api.listFavorites(token);
          const fav = favorites.find(f => f.type === "TEAM" && f.itemId === team.id);
          if (fav) {
            favoriteId = fav.id;
            updateFavUI();
          }
        } catch (err) {
          console.warn("Could not load favorites");
        }

        favBtn.addEventListener("click", async () => {
          if (isSubmitting) return;
          isSubmitting = true;
          try {
            if (favoriteId) {
              await api.deleteFavorite(token, favoriteId);
              favoriteId = null;
            } else {
              const res = await api.createFavorite(token, { type: "TEAM", itemId: team.id });
              favoriteId = res.id;
            }
            updateFavUI();
          } catch (err) {
            alert("Ocurrió un error al guardar en favoritos.");
          } finally {
            isSubmitting = false;
          }
        });
      }
    } catch (err) {
      loading.textContent =
        err instanceof ApiError ? err.messages.join(" · ") : "Error al cargar";
    }
  }
</script>
